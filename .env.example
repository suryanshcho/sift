# Sift works with no key at all. The default "auto" mode tries a
# zero-key OpenAI-compatible demo endpoint and falls back to local logic.
# It is rate-limited, so use a real key (or Ollama) for repeated demos.
AI_MODE=auto
AI_BASE_URL=https://algoholia.com/api/free-llm/v1
AI_MODEL=auto
AI_API_KEY=

# For a private/local model instead:
# AI_MODE=auto
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=ollama

# For OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...

# No network, no model calls:
# AI_MODE=local

# Optional overrides
# PORT=5050
# SIFT_DATA_DIR=./data
# SIFT_DB_PATH=./data/sift.db
